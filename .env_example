# Copy this file to .env and fill in the values. Never commit .env.

# IAM user credentials for your AWS account.
# Create an access key under IAM > Users > <your user> > Security credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only needed if you use temporary credentials (for example from AWS SSO or STS).
AWS_SESSION_TOKEN=

# Region where the service is deployed, for example us-east-1.
AWS_REGION=
AWS_DEFAULT_REGION=

# Optional: name of a profile in ~/.aws/config to use instead of the keys above.
AWS_PROFILE=
